# ---- 部署密钥与本地环境变量（需求 §6.3：.env 不入库）----
deploy/.env
deploy/prod/.env.prod
.env
# 部署指南 §2.2 让用户把 .env.prod 放到服务器仓库根（/opt/homeledger），
# 只忽略 deploy/prod/ 那一条会漏掉根目录这份——服务器上 git add -A 会把生产口令提交上去。
.env.prod
*.env.local

# ---- IDE ----
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- 日志与临时产物 ----
*.log
logs/
tmp/
output/
.qoder/

# ---- 本机专用，永不入库 ----
# 内部文档（需求文档、执行计划、审计与修复记录、发布手册）、Gitea CI 工作流、
# 图标生成与压测脚本、两份国标原文 PDF、密钥备份 bundle。说明见 local/README.md
local/

# ---- 本地运行产物 ----
# 宿主机直跑后端的落盘目录（含用户上传的真实照片，绝不能入库）
backend/data/
# scripts/backup/backup.sh 的输出目录（全量账单 dump 与照片 tar）
backups/

# 国标原文 PDF 有版权限制，不随仓库分发（数据已在代码内转录并标注来源）
docs/*.pdf
