# 家记 - 部署环境变量样例
#
# 用法：复制本文件为同目录下的 .env，再按实际环境修改。
#       .env 已被根 .gitignore 排除，禁止入库（需求 §6.3）。
#
# 仅本地开发使用；mysql / redis / app 的宿主端口已绑 127.0.0.1（见 docker-compose.yml），
# 对外入口只有 nginx（HTTP_PORT）。生产用 deploy/prod/，并替换下方所有口令与密钥（需求 §5.2）。

# ---- 宿主端口映射 ----
# 开发机上已有其他项目占用 3306 / 6379，故本项目宿主端口整体偏移，避免冲突；
# 容器内部端口仍是标准的 3306 / 6379，应用通过 compose 网络用服务名访问，不受影响。
DB_PORT=13306
REDIS_PORT=16379
APP_PORT=18080
HTTP_PORT=18088

# ---- MySQL ----
DB_NAME=homeledger
DB_USERNAME=homeledger
DB_PASSWORD=homeledger_dev_pwd
MYSQL_ROOT_PASSWORD=root_dev_pwd

# ---- Redis ----
REDIS_PASSWORD=redis_dev_pwd

# ---- 应用 ----
# 开发期放开健康检查详情便于排查；生产环境改为 never
HEALTH_SHOW_DETAILS=always

# JWT 签名密钥（需求 §5.2：密钥从环境变量注入，不入代码库）。
# 要求 Base64 编码、解码后 >= 32 字节（HS256 最小长度）。后端启动时校验，留空或不合规会直接拒绝启动。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 这里刻意留空而非给样例值：样例值会随本文件入库，一旦被复制成 .env 上线，签名密钥就等于公开。
JWT_SECRET=

# ---- S10 新增（均有 application.yml 默认值，仅需覆盖时填）----
# 档案照片：生产用 compose full 由 docker-compose.yml 直接注入 HOMELEDGER_UPLOAD_DIR 与
# HOMELEDGER_UPLOAD_USE_NGINX_ACCEL（app 与 nginx 共享 uploads-data 卷，见 README）；
# 在 .env 里额外配的照片项只对「宿主机直跑后端」生效。
# HOMELEDGER_UPLOAD_DIR=data/uploads
# HOMELEDGER_UPLOAD_USE_NGINX_ACCEL=false
# PHOTO_MAX_BYTES=5242880
# PURGE_ENABLED=true          # 解散家庭满 30 天物理清除任务（默认开）
# API_DOCS_ENABLED=true       # 生产建议 false：不暴露在线接口文档
