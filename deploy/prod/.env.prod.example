# 家记 服务器生产环境变量样例
# cp .env.prod.example .env.prod 后填写。
# .env.prod 已被根 .gitignore 排除（`deploy/.env` 与 `deploy/prod/.env.prod` 两条规则），不会入库。
# 口令泄露过一次就整套轮换：数据库口令、Redis 口令、JWT_SECRET。

# ---- MySQL 8.4（新容器，避开宿主已有的 3306；仅回环口暴露给排查用）----
DB_PORT=3307
DB_NAME=homeledger
DB_USERNAME=homeledger
DB_PASSWORD=替换成强口令
MYSQL_ROOT_PASSWORD=替换成强口令

# ---- Redis（复用宿主机已有的 redis）----
# redis 无密码就留空；有密码填实际口令
REDIS_PASSWORD=

# ---- 应用 ----
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
HEALTH_SHOW_DETAILS=never
API_DOCS_ENABLED=false